# Audio Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_BUFFER_SIZE=1024
AUDIO_DEVICE_INDEX=  # Leave empty for default microphone

# Whisper Model Configuration
WHISPER_MODEL_NAME=openai/whisper-tiny
WHISPER_DEVICE=cpu  # Use "cuda" if GPU available

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Privacy Configuration
AUDIO_RETENTION_SECONDS=0  # MUST be 0 per constitution

# MQTT Configuration (Feature 002)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
# MQTT_USERNAME=your_username  # Optional
# MQTT_PASSWORD=your_password  # Optional

# SLM Configuration (Feature 002)
SLM_MODEL_PATH=models/Phi-4-Mini-GGUF/Phi-4-mini-instruct-Q4_K_M.gguf
SLM_TIMEOUT=10  # seconds
SLM_CONTEXT_SIZE=2048
SLM_GPU_LAYERS=0  # Set to 32 if GPU available
